{
  "openapi": "3.0.3",
  "info": {
    "title": "Centrage CEPS · API de placement des paras",
    "version": "1.0",
    "description": "Masse et centrage d'avions de parachutage : modeles d'avions (places, rangees, variantes d'enveloppe, pesees), calcul des etapes de centrage d'un placement, placement optimal par le solveur `placement` (programmation lineaire en nombres entiers, HiGHS). Unites natives de chaque avion (lb et in pour Cessna, PAC, DHC-6 ; kg et m pour le PC-6), masses des paras en kg. Sans authentification ; limiteur par adresse IP (12 calculs par minute, 300 par jour), deux calculs simultanes par instance. Code source et documentation : https://github.com/juleshumbert/centrage-ceps"
  },
  "servers": [{ "url": "https://ceps09-centrage.web.app/api/v1" }],
  "paths": {
    "/version": { "get": { "summary": "Versions et limites", "responses": { "200": { "description": "OK", "content": { "application/json": { "example": { "ok": true, "api": "1.0", "solveur": "placement 1.0", "limites": { "maxParas": 30, "tempsMax": 10, "parMinute": 12, "parJour": 300, "simultanes": 2 } } } } } } } },
    "/openapi.json": { "get": { "summary": "Cette specification", "responses": { "200": { "description": "OpenAPI 3" } } } },
    "/avions": { "get": { "summary": "Liste des modeles d'avions", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "avions": { "type": "array", "items": { "$ref": "#/components/schemas/AvionResume" } } } } } } } } } },
    "/avions/{id}": { "get": { "summary": "Un modele complet", "parameters": [{ "$ref": "#/components/parameters/id" }], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "avion": { "$ref": "#/components/schemas/Avion" } } } } } }, "404": { "$ref": "#/components/responses/Erreur" } } } },
    "/avions/{id}/centrage": { "post": { "summary": "Etapes de centrage d'un placement donne (calcul pur, instantane)", "description": "Chaque para a une `place` (id de place du modele) ou une `pos` (position libre, bras et lateral en unites avion). Retourne masse, CG, %MAC, limites et marges au decollage puis apres la sortie du premier groupe (ou apres chaque rang avec `options.etapes = \"toutes\"`).", "parameters": [{ "$ref": "#/components/parameters/id" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Demande" }, "example": { "variante": "ape2", "pesee": "A", "pilote_kg": 80, "carburant": 900, "paras": [{ "nom": "Alice", "masse_kg": 93, "groupe": "VR4", "sortie": 1, "place": "G4" }, { "nom": "Bruno", "masse_kg": 105, "groupe": "VR4", "sortie": 1, "pos": { "x": 250, "y": -16 } }] } } } }, "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReponseCentrage" } } } }, "400": { "$ref": "#/components/responses/Erreur" }, "404": { "$ref": "#/components/responses/Erreur" } } } },
    "/avions/{id}/placement": { "post": { "summary": "Placement optimal par le solveur, a partir du modele", "description": "Construit le stick du solveur (places, enveloppe de la variante, carburant, pilote) et le resout : marge arriere maximale au decollage sous marge avant garantie (au decollage et apres le premier groupe), puis placement le plus realiste (groupes proches, premiers sortants pres de la porte, tandems). Un para avec `verrou` garde sa place (`verrou: \"D3\"`) ou sa position libre (`pos` + `verrou: \"libre\"`). Reponse : sortie brute du solveur (`solveur`), placement applique et etapes recalculees. Limite par IP et cache des demandes identiques (en-tete `X-Cache: hit`).", "parameters": [{ "$ref": "#/components/parameters/id" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Demande" }, "example": { "variante": "ape2", "pesee": "A", "pilote_kg": 80, "carburant": 900, "paras": [{ "nom": "Alice", "masse_kg": 93, "groupe": "VR4", "sortie": 1 }, { "nom": "Bruno", "masse_kg": 105, "groupe": "VR4", "sortie": 1 }, { "nom": "Lea", "masse_kg": 65, "tandem": "T1", "role": "passager", "sortie": 3 }, { "nom": "Marc", "masse_kg": 98, "tandem": "T1", "role": "porteur", "sortie": 3 }], "options": { "marge_avant_min": 0.5, "tolerance_marge": 0.25, "temps_max_s": 5 } } } } }, "responses": { "200": { "description": "OK (ok=false si aucun placement ne respecte les contraintes : le solveur explique et donne le meilleur compromis)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReponsePlacement" } } } }, "400": { "$ref": "#/components/responses/Erreur" }, "404": { "$ref": "#/components/responses/Erreur" }, "429": { "$ref": "#/components/responses/Erreur" }, "504": { "$ref": "#/components/responses/Erreur" } } } },
    "/placement": { "post": { "summary": "Stick brut au format du solveur", "description": "Corps = fichier d'entree du binaire `placement` (voir solveur/README.md : avion, enveloppe, carburant, pilote, porte, places, paras, options), unites libres mais coherentes. Reponse = sortie JSON du solveur.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "Sortie du solveur" }, "400": { "$ref": "#/components/responses/Erreur" }, "429": { "$ref": "#/components/responses/Erreur" } } } }
  },
  "components": {
    "parameters": { "id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "enum": ["c208b", "c208a", "pc6", "pac750xl", "dhc6"] } } },
    "responses": { "Erreur": { "description": "Erreur", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean", "example": false }, "message": { "type": "string" } } } } } } },
    "schemas": {
      "AvionResume": { "type": "object", "properties": { "id": { "type": "string" }, "libelle": { "type": "string" }, "type": { "type": "string" }, "famille": { "type": "string" }, "unites": { "$ref": "#/components/schemas/Unites" }, "nb_places": { "type": "integer" }, "variantes": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "libelle": { "type": "string" }, "mtow": { "type": "number" } } } }, "variante_defaut": { "type": "string" }, "pesees": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "libelle": { "type": "string" }, "masse_vide": { "type": "number" }, "bras_vide": { "type": "number" } } } } } },
      "Avion": { "allOf": [{ "$ref": "#/components/schemas/AvionResume" }, { "type": "object", "properties": { "places": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "x": { "type": "number", "description": "bras" }, "y": { "type": "number", "description": "lateral, > 0 a droite" }, "copilote": { "type": "boolean" }, "centre": { "type": "boolean" } } } }, "rangees": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "libelle": { "type": "string" }, "y": { "type": "number" }, "xmin": { "type": "number" }, "xmax": { "type": "number" }, "exterieur": { "type": "boolean", "description": "ligne exterieure cote porte" } } } }, "cabine": { "type": "object" }, "dessin": { "type": "object" }, "mac": { "type": "object", "properties": { "lemac": { "type": "number" }, "longueur": { "type": "number" } } }, "pilote": { "type": "object" }, "carburant": { "type": "object", "description": "capacite, valeur par defaut, table [[masse, bras]] ; kg_par_litre pour le PC-6" }, "porte": { "type": "object" }, "variantes": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "mtow": { "type": "number" }, "enveloppe": { "$ref": "#/components/schemas/Enveloppe" }, "source": { "type": "string" } } } }, "a_verifier": { "type": "array", "items": { "type": "string" } } } }] },
      "Unites": { "type": "object", "properties": { "masse": { "type": "string", "example": "lb" }, "bras": { "type": "string", "example": "in" }, "carburant": { "type": "string", "example": "lb" } } },
      "Enveloppe": { "type": "object", "description": "limite avant et arriere du CG en fonction de la masse, lignes brisees [masse, bras] interpolees", "properties": { "mtow": { "type": "number" }, "avant": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } }, "arriere": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } } } },
      "Para": { "type": "object", "required": ["masse_kg"], "properties": { "nom": { "type": "string" }, "masse_kg": { "type": "number", "description": "para equipe, kg" }, "groupe": { "type": "string" }, "sortie": { "type": "integer", "description": "rang de sortie, les ex aequo sortent ensemble" }, "tandem": { "type": "string" }, "role": { "type": "string", "enum": ["porteur", "passager"] }, "devant_de": { "type": "string" }, "interdit": { "type": "array", "items": { "type": "string" }, "description": "ids de places refusees" }, "place": { "type": "string", "description": "place occupee (centrage) ou imposee (placement, avec verrou)" }, "pos": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" } }, "description": "position libre (bras, lateral)" }, "verrou": { "oneOf": [{ "type": "boolean" }, { "type": "string" }], "description": "true, id de place ou \"libre\" : le solveur ne deplace pas ce para" } } },
      "Demande": { "type": "object", "required": ["paras"], "properties": { "variante": { "type": "string" }, "pesee": { "type": "string" }, "masse_vide": { "type": "number" }, "bras_vide": { "type": "number" }, "pilote_kg": { "type": "number" }, "carburant": { "type": "number", "description": "quantite au decollage, unite carburant de l'avion (lb ou L)" }, "porte_ouverte": { "type": "boolean", "description": "PC-6 : porte coulissante ouverte pour le largage (+21 kg.m)" }, "enveloppe": { "$ref": "#/components/schemas/Enveloppe" }, "paras": { "type": "array", "items": { "$ref": "#/components/schemas/Para" } }, "options": { "type": "object", "properties": { "marge_avant_min": { "type": "number", "default": 0.5 }, "tolerance_marge": { "type": "number", "default": 0.25 }, "etapes": { "type": "string", "enum": ["premier_groupe", "toutes", "decollage"], "default": "premier_groupe" }, "temps_max_s": { "type": "number", "default": 10, "maximum": 10 }, "groupes_ordonnes": { "type": "boolean" }, "rapide": { "type": "boolean" } } } } },
      "Etape": { "type": "object", "properties": { "etape": { "type": "string" }, "rang": { "type": "integer", "nullable": true }, "paras_a_bord": { "type": "integer" }, "masse": { "type": "number" }, "cg": { "type": "number" }, "pct_mac": { "type": "number" }, "limite_avant": { "type": "number" }, "limite_arriere": { "type": "number" }, "marge_avant": { "type": "number" }, "marge_arriere": { "type": "number" }, "statut": { "type": "string", "enum": ["ok", "avant", "arriere", "mtow"] } } },
      "ReponseCentrage": { "type": "object", "properties": { "ok": { "type": "boolean" }, "avion": { "type": "object" }, "parametres": { "type": "object" }, "etapes": { "type": "array", "items": { "$ref": "#/components/schemas/Etape" } }, "bilan": { "type": "object", "properties": { "statut": { "type": "string" }, "margeAvant": { "type": "number" }, "margeArriere": { "type": "number" } } }, "paras_sans_place": { "type": "integer" } } },
      "ReponsePlacement": { "allOf": [{ "$ref": "#/components/schemas/ReponseCentrage" }, { "type": "object", "properties": { "solveur": { "type": "object", "description": "sortie brute du solveur : marge_arriere_max, phase1, phase2, cout_realisme, premier_groupe, temps_s..." }, "placement": { "type": "array", "items": { "type": "object", "properties": { "nom": { "type": "string" }, "masse_kg": { "type": "number" }, "place": { "type": "string", "nullable": true }, "x": { "type": "number" }, "y": { "type": "number" }, "verrou": { "type": "string", "nullable": true } } } } } }] }
    }
  }
}
