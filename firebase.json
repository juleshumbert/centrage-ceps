{
  "functions": [
    {
      "source": "functions",
      "codebase": "centrage",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.test.js", "firebase-debug.log"]
    }
  ],
  "hosting": {
    "target": "centrage",
    "public": "web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "tools/**", "test/**", "package.json"],
    "rewrites": [
      { "source": "/api/placement{,/**}", "function": { "functionId": "placement", "region": "europe-west1" } }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
          { "key": "Content-Security-Policy", "value": "upgrade-insecure-requests" }
        ]
      },
      { "source": "**/*.@(css|woff2|svg|png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**/*.@(js|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] }
    ]
  }
}
